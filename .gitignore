# Basic Python .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/
.env/
.venv/

# pyenv
.python-version

# IDEs and editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Debug and dump folders (requested exceptions to ignore)
_dump/
debug/

# Logs
*.log

# Misc
*.cache
